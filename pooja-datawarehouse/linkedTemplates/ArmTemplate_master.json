{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "pooja-datawarehouse"
		},
		"AzureBlobStorage1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorage1'"
		},
		"LB__connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LB_'"
		},
		"LS_ABLB_Excel_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_ABLB_Excel'"
		},
		"LS_ABLB_INPUT_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_ABLB_INPUT'"
		},
		"LS_ABLB_lookup_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_ABLB_lookup'"
		},
		"LS_ASQL__password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_ASQL_'"
		},
		"LS_ASQL_1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_ASQL_1'"
		},
		"LS_ASQL__properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "poojaserverdb.database.windows.net"
		},
		"LS_ASQL__properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "databasetest"
		},
		"LS_ASQL__properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "pooja"
		},
		"LS_ASQL_1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "poojaserverdb.database.windows.net"
		},
		"LS_ASQL_1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "databasetest"
		},
		"LS_ASQL_1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "pooja"
		},
		"RestService1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": " https://jsonplaceholder.typicode.com"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "pooja-datawarehouse_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureBlobStorage1_connectionString": {
						"value": "[parameters('AzureBlobStorage1_connectionString')]"
					},
					"LB__connectionString": {
						"value": "[parameters('LB__connectionString')]"
					},
					"LS_ABLB_Excel_connectionString": {
						"value": "[parameters('LS_ABLB_Excel_connectionString')]"
					},
					"LS_ABLB_INPUT_connectionString": {
						"value": "[parameters('LS_ABLB_INPUT_connectionString')]"
					},
					"LS_ABLB_lookup_connectionString": {
						"value": "[parameters('LS_ABLB_lookup_connectionString')]"
					},
					"LS_ASQL__password": {
						"value": "[parameters('LS_ASQL__password')]"
					},
					"LS_ASQL_1_password": {
						"value": "[parameters('LS_ASQL_1_password')]"
					},
					"LS_ASQL__properties_typeProperties_server": {
						"value": "[parameters('LS_ASQL__properties_typeProperties_server')]"
					},
					"LS_ASQL__properties_typeProperties_database": {
						"value": "[parameters('LS_ASQL__properties_typeProperties_database')]"
					},
					"LS_ASQL__properties_typeProperties_userName": {
						"value": "[parameters('LS_ASQL__properties_typeProperties_userName')]"
					},
					"LS_ASQL_1_properties_typeProperties_server": {
						"value": "[parameters('LS_ASQL_1_properties_typeProperties_server')]"
					},
					"LS_ASQL_1_properties_typeProperties_database": {
						"value": "[parameters('LS_ASQL_1_properties_typeProperties_database')]"
					},
					"LS_ASQL_1_properties_typeProperties_userName": {
						"value": "[parameters('LS_ASQL_1_properties_typeProperties_userName')]"
					},
					"RestService1_properties_typeProperties_url": {
						"value": "[parameters('RestService1_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}